+int ksu_install_backup_sepolicy(const char *path)
+{
+    struct selinux_policy *pol;
+    struct policy_file fp = {};
+    struct file *f;
+    loff_t size, pos = 0;
+    char *data;
+    int ret;
+
+    f = filp_open(path, O_RDONLY, 0);
+    if (IS_ERR(f))
+        return PTR_ERR(f);
+
+    size = i_size_read(file_inode(f));
+    if (size <= 0 || size > SZ_64M) {
+        filp_close(f, NULL);
+        return -EINVAL;
+    }
+
+    data = vmalloc(size);
+    if (!data) {
+        filp_close(f, NULL);
+        return -ENOMEM;
+    }
+
+    ret = kernel_read(f, data, size, &pos);
+    filp_close(f, NULL);
+    if (ret != size) {
+        ret = ret < 0 ? ret : -EIO;
+        goto out_free;
+    }
+
+    pol = kzalloc(sizeof(*pol), GFP_KERNEL);
+    if (!pol) {
+        ret = -ENOMEM;
+        goto out_free;
+    }
+
+    fp.data = data;
+    fp.len = size;
+    ret = policydb_read(&pol->policydb, &fp);
+    if (ret)
+        goto out_free_pol;
+    pol->policydb.len = size;
+
+    pol->sidtab = kzalloc(sizeof(*pol->sidtab), GFP_KERNEL);
+    if (!pol->sidtab) {
+        ret = -ENOMEM;
+        goto out_free_db;
+    }
+
+    ret = policydb_load_isids(&pol->policydb, pol->sidtab);
+    if (ret)
+        goto out_free_sidtab;
+
+    backup_sepolicy = pol;
+    pr_info("backup sepolicy installed from %s (len=%lld)\n", path, size);
+    vfree(data);
+    return 0;
+
+out_free_sidtab:
+    kfree(pol->sidtab);
+out_free_db:
+    policydb_destroy(&pol->policydb);
+out_free_pol:
+    kfree(pol);
+out_free:
+    vfree(data);
+    pr_err("install backup sepolicy failed: %d\n", ret);
+    return ret;
+}
